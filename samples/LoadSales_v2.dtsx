      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{B1000000-0000-0000-0000-000000000001}" SQLTask:SqlStatementSource="MERGE dbo.FactSales AS t&#xA;USING stg.Sales AS s ON t.SaleID = s.SaleID&#xA;WHEN MATCHED THEN UPDATE SET t.Amount = s.Amount&#xA;WHEN NOT MATCHED THEN INSERT (SaleID, CustomerID, Amount, SaleDate)&#xA;  VALUES (s.SaleID, s.CustomerID, s.Amount, s.SaleDate)&#xA;WHEN NOT MATCHED BY SOURCE AND t.SaleDate &gt;= DATEADD(day, -3, GETDATE()) THEN DELETE;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchSize" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
