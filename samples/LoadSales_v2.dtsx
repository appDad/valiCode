      <DTS:ObjectData>
        <ScriptProject Name="ST_a1b2c3" VSTAMajorVersion="15" VSTAMinorVersion="0" Language="CSharp" EntryPoint="ScriptMain" ReadOnlyVariables="User::BatchSize,User::RunDate" ReadWriteVariables="">
          <ProjectItem Name="ScriptMain.cs" Encoding="UTF8"><![CDATA[using System;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_a1b2c3
{
    public partial class ScriptMain : VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            int batch = (int)Dts.Variables["User::BatchSize"].Value;
            bool fireAgain = true;
            string runDate = Dts.Variables["User::RunDate"].Value.ToString();
            Dts.Events.FireInformation(0, "Audit", "Batch size " + batch + " run " + runDate, "", 0, ref fireAgain);
            Dts.TaskResult = (int)ScriptResults.Success;
        }
    }
}
]]></ProjectItem>
